{
  "rules": {
    "liveGames": {
      "$pin": {
        ".read": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || data.child('participants').child(auth.uid).exists())",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || (data.exists() && data.child('hostUid').val() === auth.uid && !newData.exists() && data.child('status').val() === 'lobby'))",
        ".validate": "$pin.matches(/^[0-9]{6}$/) && newData.hasChildren(['hostUid', 'quizId', 'title', 'status', 'lateJoining', 'createdAt', 'totalQuestions']) && newData.child('hostUid').isString() && newData.child('quizId').isString() && newData.child('title').isString() && newData.child('title').val().length <= 100 && (newData.child('status').val() === 'lobby' || newData.child('status').val() === 'question' || newData.child('status').val() === 'answerReview' || newData.child('status').val() === 'countdown' || newData.child('status').val() === 'leaderboard' || newData.child('status').val() === 'ended') && (newData.child('status').val() !== 'countdown' || (newData.child('nextQuestionIndex').isNumber() && newData.child('countdownEndsAt').isNumber())) && newData.child('lateJoining').isBoolean() && newData.child('createdAt').isNumber() && newData.child('totalQuestions').isNumber() && newData.child('totalQuestions').val() >= 1 && newData.child('totalQuestions').val() <= 50",
        "hostUid": {
          ".validate": "newData.isString()"
        },
        "quizId": {
          ".validate": "newData.isString()"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "status": {
          ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid && ((data.val() === 'lobby' && newData.val() === 'question') || (data.val() === 'question' && newData.val() === 'answerReview') || (data.val() === 'answerReview' && (newData.val() === 'countdown' || newData.val() === 'ended')) || (data.val() === 'countdown' && newData.val() === 'question' && now >= data.parent().child('countdownEndsAt').val()) || (data.val() === 'ended' && newData.val() === 'leaderboard'))",
          ".validate": "newData.val() === 'lobby' || newData.val() === 'question' || newData.val() === 'answerReview' || newData.val() === 'countdown' || newData.val() === 'leaderboard' || newData.val() === 'ended'"
        },
        "lateJoining": {
          ".write": "auth != null && data.parent().child('hostUid').val() === auth.uid && data.parent().child('status').val() === 'lobby'",
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "totalQuestions": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
        },
        "currentQuestion": {
          ".write": "auth != null && root.child('liveGames').child($pin).child('hostUid').val() === auth.uid && (root.child('liveGames').child($pin).child('status').val() === 'lobby' || (root.child('liveGames').child($pin).child('status').val() === 'countdown' && now >= root.child('liveGames').child($pin).child('countdownEndsAt').val()))",
          ".validate": "!newData.exists() || (newData.hasChildren(['index', 'prompt', 'options', 'imageUrl', 'timeLimit', 'startedAt']) && newData.child('index').isNumber() && newData.child('prompt').isString() && newData.child('options').hasChildren(['0', '1', '2', '3']) && newData.child('imageUrl').isString() && newData.child('timeLimit').isNumber() && newData.child('startedAt').isNumber() && !newData.hasChild('correctIndex'))",
          "index": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < newData.parent().parent().child('totalQuestions').val()"
          },
          "prompt": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "options": {
            ".validate": "newData.hasChildren(['0', '1', '2', '3'])",
            "$optionIndex": {
              ".validate": "$optionIndex.matches(/^[0-3]$/) && newData.isString() && newData.val().length <= 160"
            }
          },
          "imageUrl": {
            ".validate": "newData.isString()"
          },
          "timeLimit": {
            ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 120"
          },
          "startedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": "false"
          }
        },
        "answerReveal": {
          ".write": "auth != null && root.child('liveGames').child($pin).child('hostUid').val() === auth.uid && (root.child('liveGames').child($pin).child('status').val() === 'answerReview' || (root.child('liveGames').child($pin).child('status').val() === 'countdown' && !newData.exists()))",
          ".validate": "!newData.exists() || (newData.hasChildren(['correctIndex']) && newData.child('correctIndex').isNumber() && newData.child('correctIndex').val() >= 0 && newData.child('correctIndex').val() <= 3)",
          "correctIndex": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
          },
          "$other": {
            ".validate": "false"
          }
        },
        "nextQuestionIndex": {
          ".write": "auth != null && root.child('liveGames').child($pin).child('hostUid').val() === auth.uid && (root.child('liveGames').child($pin).child('status').val() === 'answerReview' || (root.child('liveGames').child($pin).child('status').val() === 'countdown' && !newData.exists()))",
          ".validate": "newData.isNumber() && newData.val() === newData.parent().child('currentQuestion/index').val() + 1 && newData.val() < newData.parent().child('totalQuestions').val()"
        },
        "countdownEndsAt": {
          ".write": "auth != null && root.child('liveGames').child($pin).child('hostUid').val() === auth.uid && (root.child('liveGames').child($pin).child('status').val() === 'answerReview' || (root.child('liveGames').child($pin).child('status').val() === 'countdown' && !newData.exists()))",
          ".validate": "newData.isNumber()"
        },
        "participants": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === root.child('liveGames').child($pin).child('hostUid').val())",
            ".write": "auth != null && auth.uid === $uid && ((!data.exists() && root.child('liveGames').child($pin).child('status').val() === 'lobby' && root.child('liveGames').child($pin).child('nicknames').child(newData.child('nicknameKey').val()).val() === auth.uid) || (data.exists() && !newData.exists() && root.child('liveGames').child($pin).child('status').val() === 'lobby') || (data.exists() && newData.exists() && newData.child('uid').val() === data.child('uid').val() && newData.child('nickname').val() === data.child('nickname').val() && newData.child('nicknameKey').val() === data.child('nicknameKey').val() && newData.child('joinedAt').val() === data.child('joinedAt').val() && newData.child('connected').isBoolean()))",
            ".validate": "newData.hasChildren(['uid', 'nickname', 'nicknameKey', 'joinedAt', 'connected'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() === $uid"
            },
            "nickname": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20"
            },
            "nicknameKey": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "avatarId": {
              ".validate": "newData.isString() && newData.val().matches(/^(fox|panda|frog|monkey|cat|penguin|unicorn|tiger|rabbit|octopus|bear|lion)$/) && (!data.exists() || newData.val() === data.val())"
            },
            "connected": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": "false"
            }
          }
        },
        "resultId": {
          ".write": "auth != null && root.child('liveGames').child($pin).child('hostUid').val() === auth.uid && root.child('liveGames').child($pin).child('status').val() === 'answerReview' && root.child('liveGames').child($pin).child('answerReveal').exists() && root.child('liveGames').child($pin).child('currentQuestion/index').val() === root.child('liveGames').child($pin).child('totalQuestions').val() - 1",
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "nicknames": {
          "$nicknameKey": {
            ".read": "auth != null && root.child('liveGames').child($pin).child('status').val() === 'lobby'",
            ".write": "auth != null && root.child('liveGames').child($pin).child('status').val() === 'lobby' && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
            ".validate": "$nicknameKey.matches(/^[a-f0-9]{64}$/) && newData.isString()"
          }
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "gameStatus": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && root.child('liveGames').child($pin).child('hostUid').val() === auth.uid && newData.child('status').val() === 'lobby') || (!newData.exists() && root.child('liveGames').child($pin).child('hostUid').val() === auth.uid && root.child('liveGames').child($pin).child('status').val() === 'lobby'))",
        ".validate": "$pin.matches(/^[0-9]{6}$/) && newData.hasChildren(['status', 'lateJoining'])",
        "status": {
          ".write": "auth != null && root.child('liveGames').child($pin).child('hostUid').val() === auth.uid && ((data.val() === 'lobby' && newData.val() === 'question') || (data.val() === 'question' && newData.val() === 'answerReview') || (data.val() === 'answerReview' && (newData.val() === 'countdown' || newData.val() === 'ended')) || (data.val() === 'countdown' && newData.val() === 'question' && now >= root.child('liveGames').child($pin).child('countdownEndsAt').val()) || (data.val() === 'ended' && newData.val() === 'leaderboard'))",
          ".validate": "newData.val() === 'lobby' || newData.val() === 'question' || newData.val() === 'answerReview' || newData.val() === 'countdown' || newData.val() === 'leaderboard' || newData.val() === 'ended'"
        },
        "lateJoining": {
          ".write": "auth != null && root.child('liveGames').child($pin).child('hostUid').val() === auth.uid && root.child('liveGames').child($pin).child('status').val() === 'lobby'",
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "gameAnswers": {
      "$pin": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || auth.uid === root.child('liveGames').child($pin).child('hostUid').val())",
          ".write": "auth != null && ((auth.uid === root.child('liveGames').child($pin).child('hostUid').val() && !newData.exists()) || (auth.uid === $uid && !data.exists() && root.child('liveGames').child($pin).child('participants').child($uid).exists() && root.child('liveGames').child($pin).child('status').val() === 'question' && now >= root.child('liveGames').child($pin).child('currentQuestion/startedAt').val() + 5000 && now <= root.child('liveGames').child($pin).child('currentQuestion/startedAt').val() + 5000 + root.child('liveGames').child($pin).child('currentQuestion/timeLimit').val() * 1000))",
          ".validate": "!newData.exists() || (newData.hasChildren(['optionIndex', 'submittedAt']) && newData.child('optionIndex').isNumber() && newData.child('optionIndex').val() >= 0 && newData.child('optionIndex').val() <= 3 && newData.child('submittedAt').isNumber() && newData.child('submittedAt').val() >= now - 1000 && newData.child('submittedAt').val() <= now + 1000)",
          "optionIndex": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
          },
          "submittedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "liveScores": {
      "$pin": {
        ".read": "auth != null && (auth.uid === root.child('liveGames').child($pin).child('hostUid').val() || (root.child('liveGames').child($pin).child('participants').child(auth.uid).exists() && (root.child('liveGames').child($pin).child('status').val() === 'ended' || root.child('liveGames').child($pin).child('status').val() === 'leaderboard')))",
        ".write": false,
        "$uid": {
          ".write": "auth != null && auth.uid === root.child('liveGames').child($pin).child('hostUid').val() && root.child('liveGames').child($pin).child('participants').child($uid).exists()",
          ".validate": "newData.hasChildren(['uid', 'nickname', 'totalPoints', 'lastQuestionPoints', 'questionScores']) && newData.child('uid').val() === $uid && newData.child('nickname').isString() && newData.child('totalPoints').isNumber() && newData.child('totalPoints').val() >= 0 && newData.child('lastQuestionPoints').isNumber() && newData.child('lastQuestionPoints').val() >= 0 && newData.child('questionScores').hasChildren()",
          "avatarId": {
            ".validate": "newData.isString() && newData.val().matches(/^(fox|panda|frog|monkey|cat|penguin|unicorn|tiger|rabbit|octopus|bear|lion)$/) && (!data.exists() || newData.val() === data.val())"
          },
          "questionScores": {
            "$questionIndex": {
              ".validate": "$questionIndex.matches(/^[0-9]+$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
            }
          }
        }
      }
    },
    "gameContent": {
      ".read": false,
      ".write": false
    }
  }
}
